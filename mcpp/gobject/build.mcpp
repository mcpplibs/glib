// gnome.gobject — the type system.
//
// Generates the four shared outputs plus gobject-visibility.h and the
// glib-enumtypes pair, which are THIS member's and are compiled by it. See
// ../common/generators.h for why each member generates its own copy.
#include <algorithm>
#include <cctype>
#include <cstdio>
#include <cstring>
#include <filesystem>
#include <fstream>
#include <set>
#include <sstream>
#include <string>
#include <vector>

import mcpp;

#include "../common/generators.h"
#include "../common/prelude.h"
#include "../common/modules.h"

int main()
{
    if (std::string(mcpp::target_os()) != "linux") {
        note("this package builds gobject for Linux only: the generated glibconfig.h\n"
             "fixes G_OS_UNIX, the POSIX thread implementation and the POLL\n"
             "constants, none of which is right anywhere else.\n");
        return 1;
    }
    mcpp_glib_common_setup();
    // gobject's own: the visibility macros for its namespace, and the enum
    // types generated from glib/gunicode.h — compiled by THIS member because
    // g_enum_register_static is a gobject symbol.
    gen_visibility("GOBJECT", g_inc / "gobject" / "gobject-visibility.h");
    gen_enumtypes();
    // The module wrapper. It re-exports gnome.glib because glib-object.h
    // includes glib.h — and because a consumer cannot name gnome.glib itself,
    // glib being a workspace path dependency.
    gen_module("gnome.gobject", "glib-object.h",
               headers_from_umbrella(g_up / "glib" / "glib-object.h", "gobject",
                                     {g_up / "gobject", g_inc / "gobject"}),
               g_root / "src" / "gobject.cppm",
               g_inc / "gobject" / "gobject-macros.h",
               "gobject/gobject-macros.h",
               /*min_exports=*/180,
               /*reexports=*/{"gnome.glib"},
               /*macro_includes=*/{"glib/glib-macros.h"});

    mcpp::rerun_if_changed("build.mcpp");
    return 0;
}
